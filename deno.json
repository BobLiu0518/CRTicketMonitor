{
    "name": "cr-ticket-monitor",
    "version": "1.0.0",
    "description": "12306 余票监控程序",
    "author": "BobLiu",
    "license": "GPL-2.0-only",
    "exports": "./src/index.ts",
    "imports": {
        "@std/datetime": "jsr:@std/datetime@^0.225.0",
        "@std/fmt": "jsr:@std/fmt@^1.0.0",
        "open": "npm:open@^10.1.0"
    },
    "tasks": {
        "start": "deno run --allow-net --allow-read --allow-write --allow-run --allow-sys --allow-env src/index.ts",
        "build": "deno compile --allow-net --allow-read --allow-write --allow-run --allow-sys --allow-env --include=config.example.json --include=browser --icon=assets/cr.ico --output=dist/CRTM src/index.ts",
        "build:ci": "deno compile --target=$BUILD_TARGET --allow-net --allow-read --allow-write --allow-run --allow-sys --allow-env --include=config.example.json --include=browser $EXTRA_ARGS --output=$BUILD_OUTPUT src/index.ts"
    },
    "compilerOptions": {
        "lib": ["deno.window", "deno.ns", "es2022"]
    }
}
