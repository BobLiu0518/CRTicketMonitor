{
    // JSON Schema（用于校验配置文件合法性）
    "$schema": "https://crtm.bobliu.tech/config.schema.json",

    // 查询列表
    "watch": [
        // 可添加多个查询
        {
            "from": "上海",
            "to": "北京",
            "date": "20241001",
            "trains": [
                {
                    "code": "G2",
                    "from": "上海",
                    "to": "北京南",
                    "seatCategory": ["二等座"],
                    "checkRoundTrip": false
                }
            ]
        }
    ],

    // 推送配置
    "notifications": [
        // 可添加多个推送方式
        {
            "type": "Browser",
            "port": 12306
        }
    ],

    // 间隔和延迟配置
    "interval": 15,
    "delay": 5
}
